{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissões da janela principal: as leituras padrão e só os comandos da barra de título própria (#126)",
  "windows": ["main"],
  "permissions": [
    "core:default",
