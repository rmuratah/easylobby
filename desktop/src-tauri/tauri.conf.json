{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "easylobby",
  "version": "0.1.2",
  "identifier": "io.github.rmuratah.easylobby",
  "build": {
    "beforeDevCommand": "pnpm --filter easylobby-ui dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter easylobby-ui build",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "easylobby",
        "width": 1100,
        "height": 700,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false,
        "visible": false,
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ws://127.0.0.1:* http://127.0.0.1:*; img-src 'self' data: http://127.0.0.1:*; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "easylobby",
    "shortDescription": "Client leve para o League of Legends",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEzQTc5Njk0QkM4RjA4MTQKUldRVUNJKzhsSmFuRS9SVkl3OEJsZTZmdW1NNEpCOEhveDdVdks3ZTcrQ25xaW90ancwbkRwbUUK",
      "endpoints": [
        "https://github.com/rmuratah/easylobby-site/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
